{
  "name": "rnaseq-solved-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://broadinstitute.github.io/tgg-rnaseq-dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "predeploy": "npm run build && if [ -f CNAME ]; then cp CNAME dist/; fi",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gh-pages": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
